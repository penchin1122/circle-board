rules_version = '2';

// 明治就活サークル 運営ボード — Firestore セキュリティルール
// ここが「誰が何を見られて、何を編集できるか」を実際に決めています。
// 管理者アドレスは config.js の ADMIN_EMAILS と同じものにしてください。

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['satoakira.20060214@gmail.com'];
    }
    function myDoc() { return get(/databases/$(database)/documents/members/$(request.auth.uid)); }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && myDoc().data.status == 'active';
    }
    function canFinance() { return isAdmin() || (isMember() && myDoc().data.finance == true); }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // メンバー名簿：ログインした本人が「承認待ち」で自分を登録できる。承認・名前・収支閲覧の変更は管理者だけ
    match /members/{uid} {
      allow read: if isAdmin() || isMember() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'status', 'finance', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.finance == false
      );
      allow update, delete: if isAdmin();
    }

    // 設定（定例業務・カテゴリ）：メンバーは読むだけ
    match /config/{id} {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin();
    }

    // 業務カレンダー：全員が見られる。編集・削除は登録した本人と管理者。
    // 担当者（登録者以外）は「完了」チェックだけ切り替えられる
    match /tasks/{id} {
      allow read: if isAdmin() || isMember();
      allow create: if (isAdmin() || isMember())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.owner is string;
      allow update: if isAdmin()
        || (isMember() && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy)
        || (isMember() && resource.data.owner == request.auth.uid && changedOnly(['done']));
      allow delete: if isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid);
    }

    // KPI：設定・編集は管理者だけ。見られるのは viewers に入っている人（'all' なら全員）と担当者。
    // 担当者は週次の進捗（weekly）だけ書き込める
    match /kpis/{id} {
      allow read: if isAdmin() || (isMember() && (
        'all' in resource.data.viewers
        || request.auth.uid in resource.data.viewers
        || resource.data.owner == request.auth.uid
      ));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isMember() && resource.data.owner == request.auth.uid && changedOnly(['weekly']));
    }

    // 収支：見られるのは管理者と「収支の閲覧」をONにした人。編集は管理者だけ
    match /ledger/{id} {
      allow read: if canFinance();
      allow write: if isAdmin();
    }

    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
